/* VIXEN WORLD SPIDER : UNIQUE NEURAL INTERFACE */
:root {
    --vixen-pink: #ff00aa;
    --vixen-cyan: #00e5ff;
    --vixen-orange: #ffaa00;
    --vixen-dark: #0a0a0f;
    --vixen-panel: #14141b;
}

#world-spider-root {
    background-color: var(--vixen-dark);
    flex-grow: 1;
}

#tool-header {
    height: 65px;
    background-color: #050508;
    border-bottom-width: 2px;
    border-bottom-color: var(--vixen-pink);
    justify-content: center;
    padding-left: 15px;
}

.panel-header {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--vixen-pink);
}

#main-scroll {
    flex-grow: 1;
}

.spider-panel {
    background-color: var(--vixen-panel);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    margin: 10px;
    padding: 10px;
}

/* CATEGORY FOLDOUTS & SYSTEM TOPOLOGY */

.system-foldout {
    margin-bottom: 12px;
}

.system-foldout > .unity-foldout__toggle > .unity-toggle__text {
    -unity-font-style: bold;
    font-size: 14px;
    color: var(--vixen-cyan);
    letter-spacing: 1px;
}

/* Tint the foldout arrow to match the neon cyan text */
.system-foldout > .unity-foldout__toggle > .unity-toggle__input > .unity-toggle__checkmark {
    -unity-background-image-tint-color: var(--vixen-cyan);
}

.topology-container {
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    padding: 6px;
    margin-top: 5px;
}

/* "Toggle All Fixes" Button Styling */
.topology-container Button {
    background-color: var(--vixen-dark);
    border-color: var(--vixen-pink);
    border-width: 1px;
    border-radius: 3px;
    color: var(--vixen-pink);
    margin: 0px 0px 2px 0px;
    padding: 4px 10px;
    -unity-font-style: bold;
    transition: background-color 0.15s;
}

.topology-container Button:hover {
    background-color: rgba(255, 0, 170, 0.15);
}

.issue-subheader {
    font-size: 11px;
    -unity-font-style: bold;
    color: #888899;
    margin-top: 4px; /* <--- CRITICAL: Dropped from 12px to crush the dead space */
    margin-bottom: 4px;
    margin-left: 2px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    letter-spacing: 0.5px;
}

/* SPIDER RESULT ROWS */

.spider-row {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    margin-bottom: 3px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 3px;
}

.spider-row:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.indicator-bar {
    width: 4px;
    height: 20px;
    margin-right: 12px;
}

.spider-label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: #e0e0e0;
    white-space: normal;
}

/* ACTION CONTROLS & OMNI-HEURISTICS DASHBOARD */

.spider-action-btn {
    height: 35px;
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
    border-radius: 3px;
    margin: 12px 4px 0px 4px;
    background-color: #0a0a0f; 
}

.btn-cyan { color: var(--vixen-cyan); border-color: var(--vixen-cyan); border-width: 1px; }
.btn-cyan:hover { background-color: rgba(0, 229, 255, 0.1); }

.btn-pink { color: var(--vixen-pink); border-color: var(--vixen-pink); border-width: 1px; }
.btn-pink:hover { background-color: rgba(255, 0, 170, 0.1); }

.info-box-styled {
    background-color: rgba(0, 229, 255, 0.1);
    color: var(--vixen-cyan);
    padding: 8px;
    margin: 10px;
    border-left-width: 3px;
    border-left-color: var(--vixen-cyan);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.dashboard-panel {
    background-color: rgba(0, 229, 255, 0.05);
    border-width: 1px;
    border-color: var(--vixen-cyan);
    border-radius: 4px;
    margin: 10px;
    padding: 12px;
    flex-grow: 0; 
    flex-shrink: 0;
}

#dash-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--vixen-cyan);
    margin-bottom: 10px;
    letter-spacing: 1px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.3);
    padding-bottom: 4px;
}

/* FORM INPUTS & ARCHITECTURAL ELEMENTS */

.control-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--vixen-cyan);
    white-space: nowrap; 
    flex-shrink: 0;      
}

.vixen-dropdown {
    flex-grow: 1;
    flex-shrink: 1; 
    min-width: 0;   
    margin-left: 10px;
}

.vixen-dropdown > .unity-popup-field__input,
Button.vixen-dropdown {
    background-color: #0a0a0f;
    border-color: var(--vixen-cyan);
    border-width: 1px;
    border-radius: 3px;
    color: #e0e0e0;
    font-size: 13px;
    padding: 4px;
    margin: 0; 
}

Button.vixen-dropdown {
    -unity-text-align: middle-left;
    padding-left: 6px;
}

.vixen-dropdown > .unity-popup-field__input:hover,
Button.vixen-dropdown:hover {
    background-color: rgba(0, 229, 255, 0.1);
}

.vixen-object-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 10px;
}

.vixen-object-field > .unity-object-field__input {
    background-color: #0a0a0f;
    border-color: var(--vixen-cyan);
    border-width: 1px;
    border-radius: 3px;
    color: #e0e0e0;
}

.vixen-textfield {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 10px;
}

.vixen-textfield > .unity-base-text-field__input {
    background-color: #0a0a0f;
    border-color: var(--vixen-cyan);
    border-width: 1px;
    border-radius: 3px;
    color: #e0e0e0;
    padding: 4px;
}

.vixen-textfield > .unity-base-text-field__input:hover {
    background-color: rgba(0, 229, 255, 0.1);
}

/* ROW CHECKBOXES */

.vixen-toggle {
    margin-right: 8px;
    margin-left: 2px;
    align-self: center;
}

.vixen-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: #0a0a0f;
    border-color: var(--vixen-pink);
    border-width: 1px;
    border-radius: 2px;
}

.vixen-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: rgba(255, 0, 170, 0.4); 
    border-color: var(--vixen-pink);
    -unity-background-image-tint-color: #ffffff; /* Make the actual check icon pop */
}