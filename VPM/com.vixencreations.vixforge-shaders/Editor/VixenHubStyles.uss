:root {
    --hub-bg: #131316;
    --hub-head: #0e0b13;
    --hub-side: #18181c;
    --hub-surface: #1d1d22;
    --hub-surface-hover: #25252c;
    --hub-surface-press: #2c2c34;
    --hub-line: #2b2b33;
    --hub-line-soft: rgba(255, 255, 255, 0.06);
    --hub-text: #e4e4ea;
    --hub-muted: #a3a3ae;
    --hub-faint: #6f6f7a;
    --hub-cyan: #00e5ff;
    --hub-cyan-soft: rgba(0, 229, 255, 0.12);
    --hub-pink: #ff2fb4;
    --hub-pink-soft: rgba(255, 47, 180, 0.14);
    --hub-amber: #ffb547;
    --hub-amber-soft: rgba(255, 181, 71, 0.12);
    --hub-green: #3ddc84;
    --hub-green-soft: rgba(61, 220, 132, 0.14);
    --hub-strong: #ffffff;
    --hub-dim: #55555f;
    --hub-bar: #151519;
    --hub-well: #1a1a1e;
    --hub-hero: #1c1420;
    --hub-thanks: #121c20;
    --hub-code: #0d0d10;
    --hub-field-hover: #2a2a2a;
    --hub-cyan-16: rgba(0, 229, 255, 0.16);
    --hub-cyan-20: rgba(0, 229, 255, 0.2);
    --hub-cyan-25: rgba(0, 229, 255, 0.25);
    --hub-cyan-30: rgba(0, 229, 255, 0.3);
    --hub-cyan-35: rgba(0, 229, 255, 0.35);
    --hub-cyan-40: rgba(0, 229, 255, 0.4);
    --hub-cyan-45: rgba(0, 229, 255, 0.45);
    --hub-cyan-55: rgba(0, 229, 255, 0.55);
    --hub-pink-35: rgba(255, 47, 180, 0.35);
    --hub-pink-45: rgba(255, 47, 180, 0.45);
    --hub-pink-55: rgba(255, 47, 180, 0.55);
    --hub-pink-60: rgba(255, 47, 180, 0.6);
    --hub-amber-60: rgba(255, 181, 71, 0.6);
    --hub-green-35: rgba(61, 220, 132, 0.35);
    --hub-green-60: rgba(61, 220, 132, 0.6);
    --hub-btn: rgba(0, 229, 255, 0.12);
    --hub-btn-hover: rgba(0, 229, 255, 0.2);
    --hub-btn-edge: rgba(0, 229, 255, 0.35);
    --hub-btn-edge-hover: #00e5ff;
    --hub-btn-text: #00e5ff;
    --hub-btn2: #1d1d22;
    --hub-btn2-hover: #25252c;
    --hub-btn2-edge: #2b2b33;
    --hub-btn2-text: #e4e4ea;
    --hub-btn2-text-hover: #ff2fb4;
    --hub-btn2-edge-hover: rgba(255, 47, 180, 0.45);
    --hub-frame-text: #a3a3ae;
}

.unity-base-field,
.unity-button,
.unity-label,
.unity-popup-field {
    color: var(--hub-text);
}

.unity-base-popup-field__input {
    background-color: var(--hub-surface);
    border-color: var(--hub-cyan-40);
    border-width: 1px;
    border-radius: 4px;
    padding: 3px 5px;
}

.unity-base-popup-field__input:hover {
    background-color: var(--hub-field-hover);
    border-color: var(--hub-cyan);
}

.unity-base-popup-field__text {
    color: var(--hub-text);
    -unity-font-style: bold;
}

.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--hub-cyan);
}

#hub-root {
    flex-grow: 1;
    background-color: var(--hub-bg);
}

.hub-hidden {
    display: none;
}

.hub-frame-btn {
    height: 26px;
    margin: 0 0 0 6px;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--hub-btn2-edge);
    background-color: var(--hub-btn2);
    color: var(--hub-frame-text);
    font-size: 12px;
}

.hub-frame-btn:hover {
    background-color: var(--hub-btn2-hover);
    border-color: var(--hub-cyan-45);
    color: var(--hub-cyan);
}

#hub-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 48px;
    padding: 0 10px;
    background-color: var(--hub-head);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-pink-55);
}

.hub-library-btn {
    margin-left: 0;
    margin-right: 12px;
}

.hub-brand {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.hub-header-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-right: 10px;
    flex-shrink: 0;
}

.hub-window-buttons {
    flex-direction: row;
    flex-shrink: 0;
}

.hub-chip {
    height: 20px;
    margin-right: 6px;
    padding: 0 8px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--hub-line);
    background-color: var(--hub-surface);
    color: var(--hub-muted);
    font-size: 11px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.hub-chip--products {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.hub-chip--cyan {
    color: var(--hub-cyan);
    border-color: var(--hub-cyan-35);
    background-color: var(--hub-cyan-soft);
}

.hub-chip--pink {
    color: var(--hub-pink);
    border-color: var(--hub-pink-35);
    background-color: var(--hub-pink-soft);
}

.hub-chip--green {
    color: var(--hub-green);
    border-color: var(--hub-green-35);
    background-color: var(--hub-green-soft);
}

#action-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    padding: 5px 10px;
    background-color: var(--hub-bar);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line);
}

.action-btn {
    height: 26px;
    margin: 2px 6px 2px 0;
    padding: 0 12px;
    border-radius: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    border-width: 1px;
    background-color: var(--hub-btn);
    color: var(--hub-btn-text);
    border-color: var(--hub-btn-edge);
}

.action-btn:hover {
    background-color: var(--hub-btn-hover);
    border-color: var(--hub-btn-edge-hover);
}

.action-btn-alt {
    background-color: var(--hub-btn2);
    color: var(--hub-btn2-text);
    border-color: var(--hub-btn2-edge);
}

.action-btn-alt:hover {
    background-color: var(--hub-btn2-hover);
    color: var(--hub-btn2-text-hover);
    border-color: var(--hub-btn2-edge-hover);
}

.action-scope-label {
    font-size: 11px;
    margin-left: 6px;
}

#hub-root .action-scope-label {
    color: var(--hub-faint);
}

#hub-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row-reverse;
}

#hub-sidebar {
    width: 236px;
    flex-shrink: 0;
    padding: 10px 0 0 0;
    background-color: var(--hub-side);
    border-right-width: 1px;
    border-right-color: var(--hub-line);
}

#hub-search {
    width: auto;
    min-width: 0;
    flex-shrink: 0;
    margin: 0 10px 8px 10px;
}

#hub-search .unity-search-field-base__text-field__input {
    border-radius: 6px;
    border-color: var(--hub-line);
    background-color: var(--hub-bg);
    color: var(--hub-text);
}

.hub-search-hint {
    position: absolute;
    left: 22px;
    top: 2px;
    font-size: 11px;
}

#hub-root .hub-search-hint {
    color: var(--hub-faint);
}

#hub-nav-scroll {
    flex-grow: 1;
}

#hub-nav-scroll .unity-scroll-view__content-container {
    padding: 0 8px 16px 8px;
}

.hub-shelf {
    margin: 12px 0 2px 0;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 10px;
    -unity-font-style: bold;
}

.hub-shelf:hover {
    background-color: var(--hub-surface-hover);
}

#hub-root .hub-shelf {
    color: var(--hub-faint);
}

#hub-root .hub-shelf--folded {
    color: var(--hub-muted);
}

.hub-shelf-group {
    margin: 8px 0 2px 10px;
    font-size: 9px;
    -unity-font-style: bold;
}

#hub-root .hub-shelf-group {
    color: var(--hub-dim);
}

.hub-nav-item {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0 8px;
    border-radius: 6px;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
}

.hub-nav-item:hover {
    background-color: var(--hub-surface-hover);
}

.hub-nav-label {
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hub-nav-item--active {
    background-color: var(--hub-cyan-soft);
    border-left-color: var(--hub-cyan);
}

#hub-root .hub-nav-item--active .hub-nav-label {
    color: var(--hub-cyan);
    -unity-font-style: bold;
}

.hub-nav-outline {
    margin: 2px 0 6px 14px;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: var(--hub-line);
}

.hub-nav-sub {
    height: 22px;
    padding: 0 6px;
    border-radius: 4px;
    font-size: 11px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#hub-root .hub-nav-sub {
    color: var(--hub-muted);
}

.hub-nav-sub:hover {
    background-color: var(--hub-surface-hover);
}

#hub-reader {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

#docs-area,
#tools-area {
    flex-grow: 1;
    flex-shrink: 1;
}

#tools-area {
    margin: 12px;
    background-color: var(--hub-well);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--hub-line);
    overflow: hidden;
}

#main-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 12px;
    background-color: var(--hub-well);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--hub-line);
    overflow: hidden;
}

#main-scroll .unity-scroll-view__content-container {
    padding: 22px 28px 48px 28px;
}

#hub-page-head {
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line);
}

.hub-page-crumb {
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

#hub-root .hub-page-crumb {
    color: var(--hub-pink);
}

.hub-page-title {
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

#hub-root .hub-page-title {
    color: var(--hub-strong);
}

.hub-page-desc {
    margin-top: 4px;
    font-size: 13px;
    white-space: normal;
}

#hub-root .hub-page-desc {
    color: var(--hub-muted);
}

#tool-head {
    flex-shrink: 0;
    padding: 18px 20px 10px 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line);
}

#tool-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    padding: 6px 20px 0 20px;
}

.tools-caption {
    font-size: 10px;
    -unity-font-style: bold;
    margin-right: 8px;
}

#hub-root .tools-caption {
    color: var(--hub-faint);
}

.tool-toggle {
    margin: 2px 10px 2px 0;
}

#tool-host {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 8px;
    padding: 4px;
}

.hub-section-title {
    margin: 22px 0 10px 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.hub-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.hub-card {
    flex-grow: 1;
    flex-basis: 230px;
    min-width: 200px;
    margin: 0 10px 10px 0;
    padding: 12px 14px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--hub-line);
    border-left-width: 3px;
    border-left-color: var(--hub-cyan-55);
    background-color: var(--hub-surface);
}

.hub-card:hover {
    background-color: var(--hub-surface-hover);
    border-color: var(--hub-cyan-35);
    border-left-color: var(--hub-cyan);
}

.hub-card:active {
    background-color: var(--hub-surface-press);
}

.hub-card--start {
    border-left-color: var(--hub-pink-60);
}

.hub-card--docs {
    border-left-color: var(--hub-amber-60);
}

.hub-card--about {
    border-left-color: var(--hub-green-60);
}

.hub-card-title {
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

#hub-root .hub-card-title {
    color: var(--hub-strong);
}

.hub-card-desc {
    margin-top: 4px;
    font-size: 12px;
    white-space: normal;
}

#hub-root .hub-card-desc {
    color: var(--hub-muted);
}

.hub-hero {
    padding: 16px 18px;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--hub-pink-35);
    background-color: var(--hub-hero);
}

.hub-hero-top {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.hub-hero-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-right: 10px;
}

#hub-root .hub-hero-title {
    color: var(--hub-strong);
}

.hub-hero-text {
    margin-top: 6px;
    font-size: 13px;
    white-space: normal;
}

#hub-root .hub-hero-text {
    color: var(--hub-muted);
}

.hub-hero-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}

.hub-thanks {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 12px;
    padding: 12px 16px;
    border-width: 1px;
    border-left-width: 3px;
    border-radius: 10px;
    border-color: var(--hub-cyan-25);
    border-left-color: var(--hub-cyan);
    background-color: var(--hub-thanks);
}

.hub-thanks-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 260px;
    margin-right: 12px;
}

.hub-thanks-title {
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

#hub-root .hub-thanks-title {
    color: var(--hub-cyan);
}

.hub-thanks-body {
    margin-top: 2px;
    font-size: 12px;
    white-space: normal;
}

#hub-root .hub-thanks-body {
    color: var(--hub-muted);
}

.hub-thanks .hub-btn {
    margin: 6px 0;
}

.hub-btn {
    height: 28px;
    margin: 0 8px 0 0;
    padding: 0 14px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--hub-btn-edge);
    background-color: var(--hub-btn);
    color: var(--hub-btn-text);
    font-size: 12px;
    -unity-font-style: bold;
}

.hub-btn:hover {
    background-color: var(--hub-btn-hover);
    border-color: var(--hub-btn-edge-hover);
}

.hub-btn--quiet {
    border-color: var(--hub-btn2-edge);
    background-color: var(--hub-btn2);
    color: var(--hub-btn2-text);
}

.hub-btn--quiet:hover {
    background-color: var(--hub-btn2-hover);
    border-color: var(--hub-btn2-edge);
}

.hub-quick {
    flex-direction: row;
    flex-wrap: wrap;
}

.hub-quick-btn {
    height: 28px;
    margin: 0 6px 6px 0;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--hub-btn2-edge);
    background-color: var(--hub-btn2);
    color: var(--hub-btn2-text);
    font-size: 12px;
}

.hub-quick-btn:hover {
    border-color: var(--hub-cyan-45);
    background-color: var(--hub-btn2-hover);
    color: var(--hub-cyan);
}

.hub-result {
    margin-bottom: 6px;
    padding: 8px 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--hub-line-soft);
    background-color: var(--hub-surface);
}

.hub-result:hover {
    background-color: var(--hub-surface-hover);
    border-color: var(--hub-cyan-30);
}

.hub-result-where {
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

#hub-root .hub-result-where {
    color: var(--hub-pink);
}

.hub-result-text {
    margin-top: 2px;
    font-size: 12px;
    white-space: normal;
}

.hub-empty {
    margin-top: 8px;
    font-size: 13px;
    white-space: normal;
}

#hub-root .hub-empty {
    color: var(--hub-muted);
}

.cl-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.cl-bar .hub-btn {
    margin: 0;
}

.cl-picker {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 8px;
}

.cl-head {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.cl-version {
    font-size: 20px;
    -unity-font-style: bold;
    margin-right: 10px;
}

#hub-root .cl-version {
    color: var(--hub-strong);
}

.cl-summary {
    margin: 8px 0 4px 0;
    font-size: 13px;
    -unity-font-style: italic;
    white-space: normal;
}

#hub-root .cl-summary {
    color: var(--hub-muted);
}

.sup-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.sup-card {
    flex-grow: 1;
    flex-basis: 260px;
    min-width: 220px;
    margin: 0 10px 10px 0;
    padding: 12px 14px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--hub-line);
    border-left-width: 3px;
    background-color: var(--hub-surface);
}

.sup-name {
    font-size: 14px;
    -unity-font-style: bold;
}

.sup-tagline {
    margin: 4px 0 8px 0;
    font-size: 12px;
    -unity-font-style: italic;
    white-space: normal;
}

#hub-root .sup-tagline {
    color: var(--hub-muted);
}

.sup-names {
    flex-direction: row;
    flex-wrap: wrap;
}

.sup-person {
    height: 22px;
    margin: 0 6px 6px 0;
    padding: 0 10px;
    border-radius: 11px;
    border-width: 1px;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.sup-empty {
    font-size: 12px;
    white-space: normal;
}

#hub-root .sup-empty {
    color: var(--hub-faint);
}

.sup--cyan {
    border-left-color: #00f0ff;
}

#hub-root .sup--cyan .sup-name,
#hub-root .sup--cyan .sup-person {
    color: #00f0ff;
}

.sup--cyan .sup-person {
    border-color: rgba(0, 240, 255, 0.35);
}

.sup--green {
    border-left-color: #39ff14;
}

#hub-root .sup--green .sup-name,
#hub-root .sup--green .sup-person {
    color: #39ff14;
}

.sup--green .sup-person {
    border-color: rgba(57, 255, 20, 0.35);
}

.sup--orange {
    border-left-color: #ff9d00;
}

#hub-root .sup--orange .sup-name,
#hub-root .sup--orange .sup-person {
    color: #ff9d00;
}

.sup--orange .sup-person {
    border-color: rgba(255, 157, 0, 0.35);
}

.sup--gold {
    border-left-color: #ffd447;
}

#hub-root .sup--gold .sup-name,
#hub-root .sup--gold .sup-person {
    color: #ffd447;
}

.sup--gold .sup-person {
    border-color: rgba(255, 212, 71, 0.35);
}

.md-h1 {
    margin: 22px 0 8px 0;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

#hub-root .md-h1 {
    color: var(--hub-strong);
}

.md-h2 {
    margin: 22px 0 8px 0;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

#hub-root .md-h2 {
    color: var(--hub-cyan);
}

.md-h3 {
    margin: 16px 0 6px 0;
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

#hub-root .md-h3 {
    color: var(--hub-strong);
}

.md-flash {
    background-color: var(--hub-cyan-16);
}

.md-tag {
    align-self: flex-start;
    margin: 18px 0 8px 0;
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: var(--hub-cyan-soft);
}

#hub-root .md-tag {
    color: var(--hub-cyan);
}

.md-tag--changed {
    background-color: var(--hub-pink-soft);
}

#hub-root .md-tag--changed {
    color: var(--hub-pink);
}

.md-tag--fixed {
    background-color: var(--hub-green-soft);
}

#hub-root .md-tag--fixed {
    color: var(--hub-green);
}

.md-tag--heads-up,
.md-tag--removed {
    background-color: var(--hub-amber-soft);
}

#hub-root .md-tag--heads-up,
#hub-root .md-tag--removed {
    color: var(--hub-amber);
}

.md-p {
    margin: 3px 0 7px 0;
    font-size: 13px;
    white-space: normal;
}

.md-lead {
    margin: 2px 0 10px 0;
    font-size: 15px;
    white-space: normal;
}

#hub-root .md-lead {
    color: var(--hub-strong);
}

.md-li {
    flex-direction: row;
    align-items: flex-start;
    margin: 0 0 5px 4px;
}

.md-li--l1 {
    margin-left: 22px;
}

.md-li--l2 {
    margin-left: 40px;
}

.md-bullet {
    width: 16px;
    flex-shrink: 0;
    font-size: 13px;
    -unity-font-style: bold;
}

#hub-root .md-bullet {
    color: var(--hub-pink);
}

.md-li-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 13px;
    white-space: normal;
}

.md-callout {
    margin: 8px 0 10px 0;
    padding: 8px 12px;
    border-left-width: 3px;
    border-left-color: var(--hub-cyan);
    border-radius: 4px;
    background-color: var(--hub-cyan-soft);
}

.md-callout-text {
    font-size: 13px;
    white-space: normal;
}

.md-rule {
    height: 1px;
    margin: 18px 0;
    background-color: var(--hub-line);
}

.md-code {
    margin: 6px 0 10px 0;
    padding: 8px 12px;
    border-radius: 6px;
    background-color: var(--hub-code);
}

.md-code-text {
    font-size: 12px;
    white-space: normal;
}

#hub-root .md-code-text {
    color: var(--hub-amber);
}

.md-table {
    margin: 6px 0 12px 0;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--hub-line);
    overflow: hidden;
}

.md-tr {
    flex-direction: row;
    border-top-width: 1px;
    border-top-color: var(--hub-line-soft);
}

.md-tr--head {
    border-top-width: 0;
    background-color: var(--hub-surface);
}

.md-tr--first {
    border-top-width: 0;
}

.md-td {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    padding: 5px 8px;
    font-size: 12px;
    white-space: normal;
}

#hub-root .md-tr--head .md-td {
    color: var(--hub-cyan);
    -unity-font-style: bold;
}

#hub-compact-bar {
    display: none;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 36px;
    padding: 0 6px 0 10px;
    background-color: var(--hub-head);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-pink-55);
}

.hub-compact-title {
    font-size: 13px;
    -unity-font-style: bold;
}

.hub-compact-location {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
    font-size: 11px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

#hub-root .hub-compact-location {
    color: var(--hub-muted);
}

.hub-bar-buttons {
    flex-direction: row;
    flex-shrink: 0;
}

.hub-collapsed #hub-compact-bar,
.hub-minimized #hub-compact-bar {
    display: flex;
}

.hub-collapsed #hub-header,
.hub-collapsed #action-container,
.hub-collapsed #hub-sidebar,
.hub-collapsed #hub-page-head,
.hub-collapsed #tool-head,
.hub-minimized #hub-header,
.hub-minimized #action-container,
.hub-minimized #hub-body,
.hub-minimized .hub-collapse-btn {
    display: none;
}

.hub-no-sidebar #hub-sidebar {
    display: none;
}

.hub-drawer #hub-sidebar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-right-color: var(--hub-cyan-35);
}

.hub-narrow #main-scroll .unity-scroll-view__content-container {
    padding: 14px 16px 40px 16px;
}

.hub-narrow .hub-page-title {
    font-size: 20px;
}

.hub-narrow .action-btn {
    height: 22px;
    font-size: 11px;
    padding: 0 8px;
}

.hub-narrow #tool-head {
    padding: 12px 16px 8px 16px;
}

.hub-tiny #hub-header {
    height: 40px;
}

.hub-tiny .hub-header-title {
    font-size: 15px;
}

.hub-tiny .hub-chip--products,
.hub-tiny .action-scope-label,
.hub-tiny .hub-page-desc {
    display: none;
}

.hub-tiny .hub-frame-btn {
    padding: 0 8px;
}

.hub-no-lockbar #action-container {
    display: none;
}

#tool-page {
    flex-grow: 1;
}

#tool-page .unity-scroll-view__content-container {
    padding: 6px 12px 24px 12px;
}

#tool-page .hub-section-title {
    margin: 14px 0 6px 0;
}

.set-row {
    flex-direction: row;
    align-items: center;
}

.set-row .unity-base-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.set-value {
    width: 56px;
    margin-left: 6px;
    font-size: 12px;
    -unity-text-align: middle-right;
}

#hub-root .set-value {
    color: var(--hub-muted);
}

.set-note {
    margin: 2px 0 6px 3px;
    font-size: 11px;
    white-space: normal;
}

#hub-root .set-note {
    color: var(--hub-faint);
}

.set-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 6px 0 0 3px;
}

.set-buttons--end {
    margin-top: 20px;
}

.hub-has-image {
    overflow: hidden;
}

.hub-image-layer {
    position: absolute;
}

.set-sub {
    margin: 12px 0 2px 3px;
    font-size: 12px;
    -unity-font-style: bold;
}

#hub-root .set-sub {
    color: var(--hub-muted);
}

.set-mini-btn {
    height: 20px;
    margin: 0 0 0 4px;
    padding: 0 8px;
    font-size: 11px;
}
